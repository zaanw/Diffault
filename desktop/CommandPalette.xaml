<Window x:Class="ErrorHunt.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diffault commands" Width="535" Height="386" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="{StaticResource WorkspaceFont}" FontSize="13"
        Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
        PreviewKeyDown="HandleKey">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <TextBox x:Name="Query" TextChanged="SearchChanged" Padding="31,5,8,5"
                     AutomationProperties.Name="Search commands or pages"/>
            <Path Style="{StaticResource Icon}" Data="{StaticResource SearchIcon}" Width="14" Height="14"
                  HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
            <TextBlock x:Name="QueryHint" Text="Search commands or pages" Style="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="32,0,0,0" IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <ListBox x:Name="Actions" MouseDoubleClick="InvokeSelection" AutomationProperties.Name="Matching commands">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Shortcut}" Style="{StaticResource MutedCode}" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="Empty" Text="No matching commands" Style="{StaticResource Muted}" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <TextBlock Grid.Row="2" Text="↑ ↓  Select     Enter  Run     Esc  Close" Style="{StaticResource MutedCode}"
                   Margin="4,9,0,0"/>
    </Grid>
</Window>
