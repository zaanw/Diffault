<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <StartupObject>ErrorHunt.Program</StartupObject>
    <AssemblyName>Diffault</AssemblyName>
    <Product>Diffault</Product>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../VERSION').Trim())</Version>
    <ApplicationIcon>Assets/Diffault.ico</ApplicationIcon>
    <DefineConstants Condition="'$(DiffaultSmoke)' == 'true'">$(DefineConstants);DIFFAULT_SMOKE</DefineConstants>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../reports/ErrorHunt.Reports.csproj" />
    <Resource Include="Assets/Diffault.ico" />
    <EmbeddedResource Include="../examples/sample-*.log" LogicalName="Diffault.Samples.%(Filename)%(Extension)" />
    <Compile Remove="MainWindow.Smoke.cs" Condition="'$(DiffaultSmoke)' != 'true'" />
    <None Include="$(EngineExecutable)" Link="errorhunt-engine.exe"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          Condition="'$(EngineExecutable)' != ''" />
  </ItemGroup>
  <Target Name="RequireEngineForPublish" BeforeTargets="Publish" Condition="!Exists('$(EngineExecutable)')">
    <Error Text="Publish requires -p:EngineExecutable=path/to/errorhunt-engine.exe" />
  </Target>
</Project>
