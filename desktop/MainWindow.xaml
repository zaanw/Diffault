<Window x:Class="ErrorHunt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diffault" Width="1220" Height="710" MinWidth="850" MinHeight="525"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="{StaticResource WorkspaceFont}" FontSize="12.5"
        UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True"
        PreviewDragOver="PreviewLogDrag" Drop="DropLogs" PreviewKeyDown="WorkspaceKeyDown">
    <Grid x:Name="Shell" Background="{DynamicResource CanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="152"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0" Padding="8,11,8,8">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="3,0,0,15">
                    <Border Width="28" Height="28" CornerRadius="5" Background="{DynamicResource PrimaryBrush}">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource LogoIcon}" Stroke="{DynamicResource PrimaryTextBrush}" Width="16" Height="16"/>
                    </Border>
                    <TextBlock x:Name="BrandName" Text="Diffault" FontSize="16" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Click="NavigateClicked" AutomationProperties.Name="Dashboard" ToolTip="Dashboard (Ctrl+1)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource DashboardIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Dashboard" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AnalyzeNav" Style="{StaticResource NavButton}" Click="NavigateClicked" AutomationProperties.Name="Analyze" ToolTip="Analyze (Ctrl+2)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource AnalyzeIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Analyze" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="CompareNav" Style="{StaticResource NavButton}" Click="NavigateClicked" AutomationProperties.Name="Compare" ToolTip="Compare (Ctrl+3)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource CompareIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Compare" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="HistoryNav" Style="{StaticResource NavButton}" Click="NavigateClicked" AutomationProperties.Name="History" ToolTip="History (Ctrl+4)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource HistoryIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="History" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="NavigateClicked" AutomationProperties.Name="Settings" ToolTip="Settings (Ctrl+5)">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource SettingsIcon}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Settings" Margin="10,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="ToggleSidebarButton" DockPanel.Dock="Bottom" Style="{StaticResource QuietButton}"
                        Click="ToggleSidebar" ToolTip="Collapse navigation" AutomationProperties.Name="Collapse navigation"
                        HorizontalAlignment="Left" Padding="7,4">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource SidebarIcon}"/>
                </Button>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,0">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="Commands   Ctrl+K" Click="OpenCommands"
                            Style="{StaticResource QuietButton}" VerticalAlignment="Center" Margin="6,0,0,0"
                            ToolTip="Search actions and pages (Ctrl+K)"/>
                    <StackPanel x:Name="HeaderActions" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Button x:Name="HeaderSource" Content="Open source" Click="OpenSource" Margin="0,0,8,0"/>
                        <Button x:Name="HeaderExport" Content="Export" Click="OpenExportMenu" Style="{StaticResource PrimaryButton}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="PreferredExport" Header="Export preferred format" Click="ExportPreferred"/>
                                    <Separator/>
                                    <MenuItem Header="Export JSON" Click="ExportJson"/>
                                    <MenuItem Header="Export SARIF" Click="ExportSarif"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                    <Border x:Name="BusyStatus" DockPanel.Dock="Right" Background="{DynamicResource AccentSurfaceBrush}" CornerRadius="7" Padding="10,5"
                            Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <ProgressBar x:Name="BusyProgress" Width="22" Height="4" Foreground="{DynamicResource AccentTextBrush}"
                                         VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock x:Name="BusyText" Foreground="{DynamicResource AccentTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level1"/>
                        <TextBlock x:Name="PageSubtitle" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid x:Name="Workspace" Grid.Row="1" Margin="14,12,14,7">

                <ScrollViewer x:Name="DashboardPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource Panel}" Padding="12,10">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Content="Analyze log…" Style="{StaticResource PrimaryButton}" Click="OpenLog" ToolTip="Open a build log (Ctrl+O)" Margin="0,0,6,0"/>
                                    <Button Content="Compare builds" Click="GoToCompare"/>
                                </WrapPanel>
                                <StackPanel>
                                    <TextBlock Text="Project folder" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DashboardProject" Text="Not configured" Style="{StaticResource MutedCode}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid Margin="0,9,0,9">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Margin="0,0,5,0" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Latest analysis" Style="{StaticResource SectionTitle}"/>
                                    <TextBlock x:Name="DashboardLatest" Text="No report yet" Style="{StaticResource MutedCode}" Margin="0,3,0,9"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Text="Diagnostics" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="DashboardTotal" Text="—" Style="{StaticResource MetricValue}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Errors" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="DashboardErrors" Text="—" Style="{StaticResource MetricValue}" Foreground="{DynamicResource BrightErrorBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Warnings" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="DashboardWarnings" Text="—" Style="{StaticResource MetricValue}" Foreground="{DynamicResource WarningBrush}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Margin="5,0,0,0" Padding="12,10">
                                <StackPanel>
                                    <DockPanel>
                                        <Button x:Name="LatestComparisonButton" DockPanel.Dock="Right" Content="Open comparison"
                                                Style="{StaticResource QuietButton}" Click="OpenLatestComparison" Visibility="Collapsed"
                                                Padding="6,1" MinHeight="22" Margin="4,-2,-3,0"/>
                                        <TextBlock Text="Latest build delta" Style="{StaticResource SectionTitle}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="DashboardDeltaLabel" Text="Compare two builds to see changes." Style="{StaticResource MutedCode}"
                                               Margin="0,3,0,9"/>
                                    <UniformGrid Columns="3">
                                        <StackPanel>
                                            <TextBlock Text="New" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="DashboardNew" Text="—" Style="{StaticResource MetricValue}" Foreground="{DynamicResource BrightErrorBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Resolved" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="DashboardResolved" Text="—" Style="{StaticResource MetricValue}" Foreground="{DynamicResource SuccessBrush}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Persistent" Style="{StaticResource Muted}"/>
                                            <TextBlock x:Name="DashboardPersistent" Text="—" Style="{StaticResource MetricValue}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource Panel}" Padding="11,8">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,5">
                                    <Button Content="All reports" DockPanel.Dock="Right" Click="GoToHistory"
                                            Style="{StaticResource QuietButton}" MinHeight="25"/>
                                    <TextBlock Text="Recent reports" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <StackPanel x:Name="DashboardEmpty" Margin="0,7,0,7">
                                    <TextBlock x:Name="DashboardEmptyTitle" Text="No saved reports yet" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DashboardEmptyDetail" Text="Analyze a build log to start your history." Style="{StaticResource Muted}" Margin="0,3,0,0"/>
                                </StackPanel>
                                <ListBox x:Name="RecentList" ItemTemplate="{StaticResource HistoryEntry}" MaxHeight="210"
                                         AutomationProperties.Name="Recent reports" SelectionChanged="HistorySelectionChanged" MouseDoubleClick="OpenHistory" KeyDown="OpenHistoryWithKeyboard"/>
                                <StackPanel x:Name="RecentActions" Visibility="Collapsed" Margin="0,5,0,0" Orientation="Horizontal">
                                    <Button x:Name="OpenRecentButton" Content="Open report" Click="OpenSelectedHistory" IsEnabled="False"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="DiagnosticsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="AnalyzeActions">
                        <Border Style="{StaticResource DropCard}" Padding="9,6" Drop="DropAnalyze">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button Content="Paste from clipboard" Click="AnalyzeClipboard" Margin="0,0,8,0"/>
                                    <Button Content="Browse files" Style="{StaticResource PrimaryButton}" Click="OpenLog"/>
                                </StackPanel>
                                <Border DockPanel.Dock="Left" Width="27" Height="27" CornerRadius="4" Background="{DynamicResource AccentSurfaceBrush}" Margin="0,0,11,0">
                                    <Path Style="{StaticResource Icon}" Data="{StaticResource UploadIcon}" Stroke="{DynamicResource AccentTextBrush}"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Drop a build log" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text=".log, .txt, .out or .err" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Grid x:Name="AnalyzeSummary" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition Width="86"/><ColumnDefinition Width="106"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,6,0"><TextBlock x:Name="AnalyzeTotal"/></Border>
                            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,6,0"><TextBlock x:Name="AnalyzeErrors" Foreground="{DynamicResource BrightErrorBrush}"/></Border>
                            <Border Grid.Column="2" Style="{StaticResource Panel}" Padding="10,6" Margin="0,0,6,0"><TextBlock x:Name="AnalyzeWarnings" Foreground="{DynamicResource WarningBrush}"/></Border>
                            <Border Grid.Column="3" Style="{StaticResource Panel}" Padding="10,6">
                                <TextBlock x:Name="DetectedLanguages" Style="{StaticResource Muted}"/>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <StackPanel x:Name="CompareActions" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DropCard}" Padding="11,8" Drop="DropBefore">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse" Click="PickBefore" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Before" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="BeforeFile" Text="Drop the baseline log" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Path Grid.Column="1" Style="{StaticResource Icon}" Data="{StaticResource ArrowIcon}" Stroke="{DynamicResource AccentTextBrush}"/>
                            <Border Grid.Column="2" Style="{StaticResource DropCard}" Padding="11,8" Drop="DropAfter">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Browse" Click="PickAfter" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="After" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="AfterFile" Text="Drop the updated log" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                        <DockPanel Margin="0,7,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Compare JSON…" Style="{StaticResource QuietButton}" Click="CompareJson" Margin="0,0,6,0"/>
                                <Button x:Name="RunCompare" Content="Compare logs" Style="{StaticResource PrimaryButton}" IsEnabled="False" Click="CompareLogs"/>
                            </StackPanel>
                            <TextBlock x:Name="CompareHint" Text="Select the baseline and updated log." Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <Border x:Name="CompareMetrics" Style="{StaticResource Panel}" Padding="3" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="FrequencyColumn" Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="FixedButton" Style="{StaticResource DiffTab}" Click="ShowFixed" AutomationProperties.Name="Resolved issues">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource FixedIcon}" Stroke="{DynamicResource SuccessBrush}" Width="13" Height="13"/>
                                        <TextBlock Text="Resolved" Margin="6,0,7,0"/>
                                        <TextBlock x:Name="FixedCount" Foreground="{DynamicResource SuccessBrush}" FontFamily="{StaticResource CodeFont}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NewButton" Grid.Column="1" Style="{StaticResource DiffTab}" Click="ShowNew" AutomationProperties.Name="New issues">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource NewIcon}" Stroke="{DynamicResource ErrorBrush}" Width="13" Height="13"/>
                                        <TextBlock Text="New" Margin="6,0,7,0"/>
                                        <TextBlock x:Name="NewCount" Foreground="{DynamicResource BrightErrorBrush}" FontFamily="{StaticResource CodeFont}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="ExistingButton" Grid.Column="2" Style="{StaticResource DiffTab}" Click="ShowExisting" AutomationProperties.Name="Persistent issues">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource ExistingIcon}" Width="13" Height="13"/>
                                        <TextBlock Text="Persistent" Margin="6,0,7,0"/>
                                        <TextBlock x:Name="ExistingCount" Foreground="{DynamicResource MutedBrush}" FontFamily="{StaticResource CodeFont}"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="MoreFrequentButton" Grid.Column="3" Style="{StaticResource DiffTab}" Click="ShowMoreFrequent" AutomationProperties.Name="More frequent issues">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource TrendIcon}" Stroke="{DynamicResource WarningBrush}" Width="13" Height="13"/>
                                        <TextBlock Text="More frequent" Margin="6,0,7,0"/>
                                        <TextBlock x:Name="MoreFrequentCount" Foreground="{DynamicResource WarningBrush}" FontFamily="{StaticResource CodeFont}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Grid x:Name="Filters" Grid.Row="1" Margin="0,8,0,7" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.6*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="109"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="Search" AutomationProperties.Name="Search diagnostics" ToolTip="Search file, code or message"
                                 TextChanged="FilterChanged" VerticalContentAlignment="Center" Margin="0,0,7,0" Padding="31,6,9,6"/>
                        <Path Data="{StaticResource SearchIcon}" Style="{StaticResource Icon}" Width="14" Height="14"
                              HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                        <TextBlock x:Name="SearchHint" Text="Search diagnostics" Style="{StaticResource Muted}" IsHitTestVisible="False"
                                   Margin="32,0,8,0" VerticalAlignment="Center"/>
                        <ComboBox x:Name="SeverityFilter" Grid.Column="1" AutomationProperties.Name="Filter by severity" SelectionChanged="FilterChanged" Margin="0,0,7,0"/>
                        <ComboBox x:Name="LanguageFilter" Grid.Column="2" AutomationProperties.Name="Filter by language" SelectionChanged="FilterChanged" Margin="0,0,7,0"/>
                        <ComboBox x:Name="FileFilter" Grid.Column="3" AutomationProperties.Name="Filter by file" SelectionChanged="FilterChanged" ToolTip="Filter diagnostics by file"/>
                    </Grid>

                    <Grid x:Name="DiagnosticPanes" Grid.Row="2" SizeChanged="DiagnosticPanesResized">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="GridColumn" Width="*" MinWidth="300"/>
                            <ColumnDefinition x:Name="GripColumn" Width="0"/>
                            <ColumnDefinition x:Name="DetailColumn" Width="0"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,0" Padding="0" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel x:Name="TableHeader" Margin="12,7,12,7" Visibility="Collapsed">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <CheckBox x:Name="GroupByFile" Content="Group by file" Click="ToggleFileGrouping"
                                                  ToolTip="Group visible diagnostics by source file" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="ResultCount" VerticalAlignment="Center" Style="{StaticResource MutedCode}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ResultTitle" Text="Diagnostics" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <DataGrid x:Name="Results" Grid.Row="1" SelectionChanged="SelectDiagnostic" CanUserSortColumns="True"
                                          AutomationProperties.Name="Diagnostics" Visibility="Collapsed" PreviewMouseRightButtonDown="SelectContextRow"
                                          VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu Opened="UpdateDiagnosticMenu">
                                            <MenuItem Header="Copy diagnostic" Click="CopyDiagnostic" InputGestureText="Ctrl+C"/>
                                            <MenuItem Header="Copy original log text" Click="CopyOriginal"/>
                                            <MenuItem x:Name="ContextOpenSource" Header="Open source" Click="OpenSource"/>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.GroupStyle>
                                        <GroupStyle ContainerStyle="{StaticResource FileGroup}"/>
                                    </DataGrid.GroupStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="82" ElementStyle="{StaticResource SeverityCell}"/>
                                        <DataGridTextColumn x:Name="StatusColumn" Header="Status" Binding="{Binding Status}" Width="76" ElementStyle="{StaticResource StatusCell}"/>
                                        <DataGridTextColumn x:Name="DiagnosticFileColumn" Header="File" Binding="{Binding FileName}"
                                                            Width="0.9*" MinWidth="70" ElementStyle="{StaticResource CodeCell}"/>
                                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="69" ElementStyle="{StaticResource CodeCell}"/>
                                        <DataGridTextColumn Header="Code" Binding="{Binding Item.Code}" Width="76" ElementStyle="{StaticResource CodeCell}"/>
                                        <DataGridTextColumn Header="Message" Binding="{Binding Item.Message}" Width="1.5*" MinWidth="90" ElementStyle="{StaticResource CellText}"/>
                                        <DataGridTextColumn Header="Repeats" Binding="{Binding Occurrences}" SortMemberPath="Item.Count" Width="85" ElementStyle="{StaticResource CodeCell}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <StackPanel x:Name="DiagnosticEmpty" Grid.Row="1" Margin="15,10" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="38" Height="38" CornerRadius="9" Background="{DynamicResource AccentSurfaceBrush}" Margin="0,0,0,9">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource AnalyzeIcon}" Stroke="{DynamicResource AccentTextBrush}"/>
                                    </Border>
                                    <TextBlock x:Name="DiagnosticEmptyTitle" Text="No log loaded" FontSize="16" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DiagnosticEmptyBody" Text="Drop a file above to inspect its diagnostics." Style="{StaticResource Muted}"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <GridSplitter x:Name="DetailGrip" Grid.Column="1" Width="6" VerticalAlignment="Stretch"
                                      HorizontalAlignment="Center" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                                      ShowsPreview="False" Background="{DynamicResource BorderBrush}" DragCompleted="DetailResizeCompleted"
                                      FocusVisualStyle="{x:Null}" AutomationProperties.Name="Resize the diagnostic inspector"
                                      ToolTip="Drag to resize the inspector, or use the arrow keys when focused." Visibility="Collapsed"/>
                        <Border x:Name="DetailPanel" Grid.Column="2" Style="{StaticResource Panel}" Padding="10"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Click="CloseDetails" Style="{StaticResource QuietButton}" Padding="6" MinHeight="28"
                                            AutomationProperties.Name="Close diagnostic details">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource CloseIcon}" Width="13" Height="13"/>
                                    </Button>
                                    <TextBlock Text="Inspector" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock x:Name="DetailSeverity" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock x:Name="DetailMessage" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,6"/>
                                        <TextBlock x:Name="DetailLocation" Style="{StaticResource MutedCode}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Copy diagnostic" Click="CopyDiagnostic" Margin="0,0,5,4" Padding="7,3" MinHeight="25"/>
                                            <Button x:Name="OpenSourceButton" Content="Open source" Click="OpenSource"
                                                    Visibility="Collapsed" Padding="7,3" MinHeight="25" Margin="0,0,0,4"/>
                                        </WrapPanel>
                                        <Expander x:Name="LogSection" Header="Log excerpt" IsExpanded="True" Style="{StaticResource SectionExpander}">
                                            <StackPanel Margin="0,5,0,0">
                                                <DockPanel Margin="0,0,0,4">
                                                    <Button Content="Copy original" Click="CopyOriginal" Style="{StaticResource QuietButton}"
                                                            DockPanel.Dock="Right" Padding="5,1" MinHeight="22"/>
                                                    <TextBlock x:Name="ExcerptStatus" Text="Excerpt lines" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                </DockPanel>
                                                <RichTextBox x:Name="Original" IsReadOnly="True" IsDocumentEnabled="False" IsUndoEnabled="False"
                                                             Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                             Foreground="{DynamicResource TextBrush}" BorderThickness="1"
                                                             FontFamily="{StaticResource CodeFont}" FontSize="11"
                                                             MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                             AutomationProperties.Name="Original diagnostic with excerpt line numbers"/>
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,10">
                        <Button x:Name="OpenHistoryButton" DockPanel.Dock="Right" Content="Open report" Click="OpenSelectedHistory"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" IsEnabled="False"/>
                        <ComboBox x:Name="HistoryKindFilter" DockPanel.Dock="Right" Width="138" Margin="7,0,0,0" SelectedIndex="0"
                                  SelectionChanged="HistoryFilterChanged" AutomationProperties.Name="Filter history by report type">
                            <ComboBoxItem Content="All types"/><ComboBoxItem Content="Analysis"/><ComboBoxItem Content="Comparison"/><ComboBoxItem Content="Saved report"/>
                        </ComboBox>
                        <Grid>
                            <TextBox x:Name="HistorySearch" AutomationProperties.Name="Search history" TextChanged="HistorySearchChanged"
                                     VerticalContentAlignment="Center" Padding="31,6,9,6"/>
                            <Path Data="{StaticResource SearchIcon}" Style="{StaticResource Icon}" Width="14" Height="14"
                                  HorizontalAlignment="Left" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock x:Name="HistorySearchHint" Text="Search saved reports" Style="{StaticResource Muted}" IsHitTestVisible="False"
                                       Margin="32,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="12">
                        <Grid>
                            <DataGrid x:Name="HistoryList" AutomationProperties.Name="Saved reports" SelectionChanged="HistorySelectionChanged"
                                      MouseDoubleClick="OpenHistory" KeyDown="OpenHistoryWithKeyboard" PreviewMouseRightButtonDown="SelectContextRow">
                                <DataGrid.ContextMenu>
                                    <ContextMenu Opened="UpdateHistoryMenu">
                                        <MenuItem Header="Open report" Click="OpenSelectedHistory"/>
                                        <MenuItem Header="Copy report name" Click="CopyHistoryName"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Report" Binding="{Binding Label}" Width="*" MinWidth="130" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="120" ElementStyle="{StaticResource CellText}"/>
                                    <DataGridTextColumn Header="Diagnostics" Binding="{Binding Entry.DiagnosticCount, TargetNullValue=—}"
                                                        SortMemberPath="Entry.DiagnosticCount" Width="105" ElementStyle="{StaticResource CodeCell}"/>
                                    <DataGridTextColumn Header="Saved" Binding="{Binding LocalDate}" SortMemberPath="Entry.Date"
                                                        Width="170" ElementStyle="{StaticResource CodeCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="HistoryEmpty" Margin="14,6" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="HistoryEmptyTitle" Text="No saved reports" FontSize="16" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock x:Name="HistoryEmptyBody" Text="Reports appear here when saving history is enabled."
                                           Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,11">
                            <Expander Header="Appearance" IsExpanded="True" Style="{StaticResource SectionExpander}">
                            <StackPanel Margin="0,3,0,1">
                                <DockPanel Margin="0,10,0,0">
                                    <ComboBox x:Name="ThemeSelection" DockPanel.Dock="Right" Width="132"
                                              AutomationProperties.Name="Theme" SelectionChanged="PreviewAppearance">
                                        <ComboBoxItem Content="System"/><ComboBoxItem Content="Light"/><ComboBoxItem Content="Dark"/>
                                    </ComboBox>
                                    <TextBlock Text="Theme" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                            </Expander>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,11">
                            <Expander Header="Source files" IsExpanded="True" Style="{StaticResource SectionExpander}">
                            <StackPanel Margin="0,3,0,1">
                                <TextBlock Text="Choose the local folder and editor used by Open source." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,11"/>
                                <DockPanel Margin="0,0,0,10">
                                    <Button DockPanel.Dock="Right" Content="Choose folder…" Click="ChooseProject" Margin="8,0,0,0"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Project folder" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="ProjectPath" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                                        <Button Content="Use Notepad" Style="{StaticResource QuietButton}" Click="ResetEditor" Margin="0,0,6,0"/>
                                        <Button Content="Choose editor…" Click="ChooseEditor"/>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Editor" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="EditorPath" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                            </Expander>
                        </Border>
                        <Border Style="{StaticResource Panel}" Margin="0,0,0,11">
                            <Expander Header="Reports and history" IsExpanded="True" Style="{StaticResource SectionExpander}">
                            <StackPanel Margin="0,3,0,1">
                                <DockPanel Margin="0,10,0,10">
                                    <ComboBox x:Name="ExportFormat" DockPanel.Dock="Right" Width="115" AutomationProperties.Name="Preferred export format">
                                        <ComboBoxItem Content="JSON"/><ComboBoxItem Content="SARIF"/>
                                    </ComboBox>
                                    <TextBlock Text="Preferred export format" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <CheckBox x:Name="SaveHistory" Content="Save analyses to local history"/>
                            </StackPanel>
                            </Expander>
                        </Border>
                        <Button x:Name="SaveSettingsButton" Content="Save settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings" HorizontalAlignment="Left"/>
                        <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                            <Expander Header="Diagnostics" IsExpanded="True" Style="{StaticResource SectionExpander}">
                            <StackPanel Margin="0,3,0,1">
                                <TextBlock Text="Review local startup and error codes. Diagnostic logs omit filenames and input content."
                                           Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,11"/>
                                <WrapPanel>
                                    <Button Content="View diagnostic log" Click="ViewDiagnosticLog" Margin="0,0,8,0"/>
                                    <Button Content="Export diagnostic log…" Click="ExportDiagnosticLog"/>
                                </WrapPanel>
                            </StackPanel>
                            </Expander>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Background="{DynamicResource PanelBrush}" Padding="21,0">
                <DockPanel>
                    <TextBlock x:Name="WorkspaceStatus" DockPanel.Dock="Right" Style="{StaticResource MutedCode}"
                               VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"/>
                    <TextBlock x:Name="Status" Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                               AutomationProperties.LiveSetting="Polite" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
